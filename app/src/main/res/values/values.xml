<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- RustDesk Signature Color Palette -->
    <color name="rustdesk_blue">#0F62FE</color>
    <color name="rustdesk_blue_dark">#0043CE</color>
    <color name="rustdesk_blue_light">#4589FF</color>
    <color name="rustdesk_blue_tint">#132442</color>

    <color name="background">#111317</color>
    <color name="surface">#1A1D24</color>
    <color name="surface_variant">#242832</color>
    <color name="surface_elevated">#2D323E</color>

    <color name="accent_green">#24A148</color>
    <color name="accent_green_tint">#122A1E</color>
    <color name="accent_amber">#F1C21B</color>
    <color name="accent_red">#DA1E28</color>

    <color name="text_primary">#F4F4F4</color>
    <color name="text_secondary">#A8B0BE</color>
    <color name="text_muted">#69707D</color>

    <!-- Compat aliases -->
    <color name="primary">#0F62FE</color>
    <color name="primary_variant">#0043CE</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="ic_launcher_background">#0F62FE</color>

    <string name="app_name">RustDesk</string>

    <style name="Theme.RustDeskStandalone" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/rustdesk_blue</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <style name="Theme.RustDeskStandalone.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">#000000</item>
    </style>
</resources>